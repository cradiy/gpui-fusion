{
  "$schema": "../../../../tools/gpuiforge/gpuiforge.schema.json",
  "app": {
    "name": "GPUI Effects"
  },
  "platforms": {
    "android": {
      "abis": [
        "arm64-v8a",
        "x86_64"
      ],
      "application-id": "dev.gpui.effects",
      "build": [
        {
          "args": [
            "gradle",
            "--",
            "--no-daemon",
            "-PgpuiAbis={{abis}}",
            "-PgpuiForgeExecutable={{tool_path}}",
            ":app:assemble{{variant}}"
          ],
          "cwd": "{{project_dir}}",
          "program": "{{tool_path}}"
        }
      ],
      "features": [],
      "permissions": [],
      "run": [
        {
          "args": [
            "-s",
            "{{device}}",
            "install",
            "-r",
            "{{artifact}}"
          ],
          "program": "{{adb}}"
        },
        {
          "args": [
            "-s",
            "{{device}}",
            "shell",
            "am",
            "start",
            "-W",
            "-n",
            "{{application_id}}/{{activity}}"
          ],
          "error-pattern": "Error:",
          "program": "{{adb}}"
        }
      ]
    },
    "desktop": {
      "build": [
        {
          "args": [
            "build",
            "-p",
            "effects_android",
            "--profile",
            "{{cargo_profile}}"
          ],
          "program": "cargo"
        }
      ],
      "run": [
        {
          "args": [
            "run",
            "-p",
            "effects_android",
            "--profile",
            "{{cargo_profile}}"
          ],
          "program": "cargo"
        }
      ]
    }
  }
}
