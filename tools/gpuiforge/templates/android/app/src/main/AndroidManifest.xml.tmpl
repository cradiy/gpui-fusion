<manifest xmlns:android="http://schemas.android.com/apk/res/android">
{{android_permissions}}
    <uses-feature android:name="android.hardware.vulkan.level" android:version="0" android:required="false" />
    <application android:label="{{app.name|xml}}" {{android_icon}} android:theme="@style/GpuiTheme" android:allowBackup="false" android:supportsRtl="true">
        <activity android:name="dev.gpuiforge.app.MainActivity" android:exported="true" android:launchMode="singleTop" android:enableOnBackInvokedCallback="true"
<!-- gpuiforge:if media -->
            android:supportsPictureInPicture="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
<!-- gpuiforge:endif -->
            >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
{{android_url_filters}}
{{android_share_filters}}
        </activity>
    </application>
</manifest>
